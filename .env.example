PORT=5050
NODE_ENV=production

# Supabase project (Project Settings > API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is server-only -- never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Same URL/anon key, exposed to the browser bundle for the Google sign-in
# redirect only (see client/src/supabaseClient.js). The anon key is public by
# design; VITE_-prefixed vars are the only ones Vite ever ships to the client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Before running the app against a fresh project:
#   1. Run server/supabase/migrations/0001_init.sql and then 0002_grants.sql in
#      the Supabase SQL editor, in that order. Skipping 0002 leaves the tables
#      ungranted (the server crash-loops at boot with "permission denied for
#      table companies") and leaves the SECURITY DEFINER RPCs callable by the
#      public anon key.
#   2. Authentication > Providers > Email: enable "Confirm email".
#   3. Authentication > Providers > Google: enable it and paste your Google
#      OAuth Client ID and Client Secret (from Google Cloud Console >
#      APIs & Services > Credentials). NEVER put the client secret in this
#      repo or in a VITE_-prefixed var -- it belongs only in the Supabase
#      dashboard.
#   4. In Google Cloud Console, add this project's callback as an Authorized
#      redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#      (shown on the Supabase Google provider settings page).
#   5. Authentication > URL Configuration: set Site URL to CLIENT_ORIGIN/APP_URL
#      and add "<APP_URL>/confirm", "<APP_URL>/reset-password" and
#      "<APP_URL>/oauth/callback" as redirect URLs.
#   6. Authentication > Emails / SMTP Settings: configure outgoing mail (Supabase's
#      default mailer is rate-limited and meant for development only).

CLIENT_ORIGIN=https://yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-chars
ADMIN_RECOVERY_CODE=replace-with-a-different-random-recovery-code

ADMIN_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-chars
ADMIN_AUTH_STATE_PATH=server/.data/admin-auth.json
TRUST_PROXY=false
MAX_UPLOAD_BYTES=10485760
MAX_SPREADSHEET_ROWS=50000

# Security Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_STRICT_MAX=20
RATE_LIMIT_UPLOAD_MAX=5

# Where Supabase's confirmation/reset-link emails point back to. Defaults to
# CLIENT_ORIGIN. Must also be added under Redirect URLs (see step 3 above).
APP_URL=https://yourdomain.com
